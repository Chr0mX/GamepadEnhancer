<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ── Base ─────────────────────────────────────────────────────────────── -->
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>

  <!-- Consistent control height (32) and radius (6) -->
  <Style Selector="Button, ToggleButton">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="11,0" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="NumericUpDown">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="CornerRadius" Value="3" />
  </Style>

  <!-- Keyboard focus ring: one visible, consistent indicator on every interactive control -->
  <Style Selector="Button:focus-visible, ToggleButton:focus-visible, RadioButton:focus-visible, CheckBox:focus-visible, ComboBox:focus-visible, ListBoxItem:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!-- ── Typography ───────────────────────────────────────────────────────── -->
  <Style Selector="TextBlock.title">
    <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="26" />
  </Style>
  <Style Selector="TextBlock.pagetitle">
    <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.8" />
  </Style>
  <Style Selector="TextBlock.stat">
    <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
    <Setter Property="FontSize" Value="21" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.lab">
    <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="1.2" />
    <Setter Property="Foreground" Value="{DynamicResource FaintTextBrush}" />
  </Style>
  <Style Selector="TextBlock.h">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.eyebrow">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource FaintTextBrush}" />
    <Setter Property="Margin" Value="12,14,0,4" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- ── Panels ───────────────────────────────────────────────────────────── -->
  <Style Selector="Border.panel, Border.card">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSubtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="16" />
  </Style>
  <Style Selector="Border.card">
    <Setter Property="Padding" Value="12" />
  </Style>
  <Style Selector="Border.rowline">
    <Setter Property="Padding" Value="0,7" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSubtle}" />
  </Style>
  <!-- Metric tile: a small label over a coloured monospace value, the unit of presentation on the dashboard -->
  <Style Selector="Border.tile">
    <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSubtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="9,6" />
  </Style>
  <Style Selector="TextBlock.tilelab">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.8" />
    <Setter Property="Foreground" Value="{DynamicResource FaintTextBrush}" />
  </Style>
  <Style Selector="TextBlock.val">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.val.blue"><Setter Property="Foreground" Value="{DynamicResource ValueBlueBrush}" /></Style>
  <Style Selector="TextBlock.val.green"><Setter Property="Foreground" Value="{DynamicResource ValueGreenBrush}" /></Style>
  <Style Selector="TextBlock.val.orange"><Setter Property="Foreground" Value="{DynamicResource ValueOrangeBrush}" /></Style>
  <Style Selector="TextBlock.val.purple"><Setter Property="Foreground" Value="{DynamicResource ValuePurpleBrush}" /></Style>
  <Style Selector="TextBlock.unit">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource FaintTextBrush}" />
  </Style>
  <!-- A protocol/state tag in the header -->
  <Style Selector="Border.tag">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushDefault}" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="6,1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.tag TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource FaintTextBrush}" />
  </Style>
  <Style Selector="Border.tag.on"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Style>
  <Style Selector="Border.tag.on TextBlock"><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" /></Style>
  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource BorderBrushSubtle}" />
  </Style>

  <!-- ── Buttons ──────────────────────────────────────────────────────────── -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource OnAccentBrush}" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource OnAccentBrush}" />
  </Style>
  <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSubtle}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource FaintTextBrush}" />
  </Style>

  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <Style Selector="Button.danger">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DangerTintBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerBrush}" />
  </Style>

  <Style Selector="Button.icon">
    <Setter Property="Width" Value="32" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <!-- Segmented switch (two or three mutually exclusive choices, e.g. controller layout) -->
  <Style Selector="RadioButton.seg">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="SegRoot" Background="Transparent" CornerRadius="2" Padding="{TemplateBinding Padding}" MinHeight="{TemplateBinding MinHeight}">
          <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                            VerticalAlignment="Center" HorizontalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.seg:pointerover /template/ Border#SegRoot">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>
  <Style Selector="RadioButton.seg:checked /template/ Border#SegRoot">
    <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
  </Style>
  <Style Selector="RadioButton.seg:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentTextBrush}" />
    <Setter Property="TextElement.FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="RadioButton.seg:focus-visible /template/ Border#SegRoot">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!-- Rail navigation item: an icon, a name in the tooltip, an accent bar when selected -->
  <Style Selector="RadioButton.nav">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
    <Setter Property="Margin" Value="0,2" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="NavRoot" Background="Transparent" CornerRadius="8" BorderThickness="0">
          <Grid>
            <Border x:Name="NavBar" Width="3" Height="20" CornerRadius="2" Background="Transparent" HorizontalAlignment="Left" Margin="-10,0,0,0" />
            <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource FaintTextBrush}" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.nav:pointerover /template/ Border#NavRoot">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>
  <Style Selector="RadioButton.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="RadioButton.nav:checked /template/ Border#NavRoot">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
  </Style>
  <Style Selector="RadioButton.nav:checked /template/ Border#NavBar">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="RadioButton.nav:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="RadioButton.nav:focus-visible /template/ Border#NavRoot">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!-- Header pills and the segmented container -->
  <Style Selector="Border.pill">
    <Setter Property="Height" Value="24" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushDefault}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.segbox">
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushDefault}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- A keyboard key: monospace, bordered, heavier bottom edge -->
  <Style Selector="Border.kbd">
    <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushStrong}" />
    <Setter Property="BorderThickness" Value="1,1,1,2" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="6,1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Tab: instrument-style, text only, an underline marks the selected one -->
  <Style Selector="RadioButton.tab">
    <Setter Property="Height" Value="34" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="TabRoot" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}">
          <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                            VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.tab:pointerover /template/ Border#TabRoot">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>
  <Style Selector="RadioButton.tab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="RadioButton.tab:checked /template/ Border#TabRoot">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="RadioButton.tab:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="TextElement.FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="RadioButton.tab:focus-visible /template/ Border#TabRoot">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>

  <!-- ── Lists ────────────────────────────────────────────────────────────── -->
  <Style Selector="ListBox.plain">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.plain > ListBoxItem">
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Margin" Value="0,0,0,2" />
    <Setter Property="CornerRadius" Value="3" />
  </Style>
  <Style Selector="Expander">
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="CheckBox, ToggleSwitch">
    <Setter Property="MinHeight" Value="28" />
  </Style>
  <Style Selector="ScrollViewer">
    <Setter Property="AllowAutoHide" Value="True" />
  </Style>

  <!-- ── Status dot ───────────────────────────────────────────────────────── -->
  <Style Selector="Ellipse.dot">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="Fill" Value="{DynamicResource FaintTextBrush}" />
  </Style>
  <Style Selector="Ellipse.dot.ok"><Setter Property="Fill" Value="{DynamicResource SuccessBrush}" /></Style>
  <Style Selector="Ellipse.dot.warn"><Setter Property="Fill" Value="{DynamicResource WarningBrush}" /></Style>
  <Style Selector="Ellipse.dot.err"><Setter Property="Fill" Value="{DynamicResource DangerBrush}" /></Style>
</Styles>
