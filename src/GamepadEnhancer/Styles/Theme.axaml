<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Re-point the Fluent control resources at the app tokens, so hover/pressed/focus/disabled states come from the tokens too. -->
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <StaticResource x:Key="ButtonBackground" ResourceKey="RaisedBrush" />
          <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="HoverBrush" />
          <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="PressedBrush" />
          <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="SurfaceBrush" />
          <StaticResource x:Key="ButtonForeground" ResourceKey="TextBrush" />
          <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="TextBrush" />
          <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="TextBrush" />
          <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="FaintTextBrush" />
          <StaticResource x:Key="ButtonBorderBrush" ResourceKey="BorderBrushDefault" />
          <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="BorderBrushStrong" />
          <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="BorderBrushStrong" />
          <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="BorderBrushSubtle" />

          <StaticResource x:Key="TextControlBackground" ResourceKey="SurfaceBrush" />
          <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="SurfaceBrush" />
          <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="SurfaceBrush" />
          <StaticResource x:Key="TextControlBackgroundDisabled" ResourceKey="SidebarBrush" />
          <StaticResource x:Key="TextControlBorderBrush" ResourceKey="BorderBrushDefault" />
          <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="BorderBrushStrong" />
          <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="AccentBrush" />
          <StaticResource x:Key="TextControlBorderBrushDisabled" ResourceKey="BorderBrushSubtle" />
          <StaticResource x:Key="TextControlForeground" ResourceKey="TextBrush" />
          <StaticResource x:Key="TextControlForegroundPointerOver" ResourceKey="TextBrush" />
          <StaticResource x:Key="TextControlForegroundFocused" ResourceKey="TextBrush" />
          <StaticResource x:Key="TextControlForegroundDisabled" ResourceKey="FaintTextBrush" />
          <StaticResource x:Key="TextControlPlaceholderForeground" ResourceKey="FaintTextBrush" />

          <StaticResource x:Key="ComboBoxBackground" ResourceKey="SurfaceBrush" />
          <StaticResource x:Key="ComboBoxBackgroundPointerOver" ResourceKey="SurfaceBrush" />
          <StaticResource x:Key="ComboBoxBackgroundPressed" ResourceKey="SurfaceBrush" />
          <StaticResource x:Key="ComboBoxBackgroundDisabled" ResourceKey="SidebarBrush" />
          <StaticResource x:Key="ComboBoxBorderBrush" ResourceKey="BorderBrushDefault" />
          <StaticResource x:Key="ComboBoxBorderBrushPointerOver" ResourceKey="BorderBrushStrong" />
          <StaticResource x:Key="ComboBoxBorderBrushPressed" ResourceKey="AccentBrush" />
          <StaticResource x:Key="ComboBoxBorderBrushDisabled" ResourceKey="BorderBrushSubtle" />
          <StaticResource x:Key="ComboBoxDropDownBackground" ResourceKey="RaisedBrush" />
          <StaticResource x:Key="ComboBoxDropDownBorderBrush" ResourceKey="BorderBrushDefault" />

          <StaticResource x:Key="ListBoxItemBackgroundPointerOver" ResourceKey="HoverBrush" />
          <StaticResource x:Key="ListBoxItemBackgroundSelected" ResourceKey="AccentTintBrush" />
          <StaticResource x:Key="ListBoxItemBackgroundSelectedPointerOver" ResourceKey="AccentTintBrush" />
          <StaticResource x:Key="ListBoxItemBackgroundSelectedPressed" ResourceKey="AccentTintBrush" />

          <StaticResource x:Key="ToolTipBackground" ResourceKey="RaisedBrush" />
          <StaticResource x:Key="ToolTipForeground" ResourceKey="TextBrush" />
          <StaticResource x:Key="ToolTipBorderBrush" ResourceKey="BorderBrushStrong" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <StaticResource x:Key="ButtonBackground" ResourceKey="RaisedBrush" />
          <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="HoverBrush" />
          <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="PressedBrush" />
          <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="SurfaceBrush" />
          <StaticResource x:Key="ButtonForeground" ResourceKey="TextBrush" />
          <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="TextBrush" />
          <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="TextBrush" />
          <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="FaintTextBrush" />
          <StaticResource x:Key="ButtonBorderBrush" ResourceKey="BorderBrushDefault" />
          <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="BorderBrushStrong" />
          <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="BorderBrushStrong" />
          <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="BorderBrushSubtle" />

          <StaticResource x:Key="TextControlBackground" ResourceKey="SurfaceBrush" />
          <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="SurfaceBrush" />
          <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="SurfaceBrush" />
          <StaticResource x:Key="TextControlBackgroundDisabled" ResourceKey="SidebarBrush" />
          <StaticResource x:Key="TextControlBorderBrush" ResourceKey="BorderBrushDefault" />
          <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="BorderBrushStrong" />
          <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="AccentBrush" />
          <StaticResource x:Key="TextControlBorderBrushDisabled" ResourceKey="BorderBrushSubtle" />
          <StaticResource x:Key="TextControlForeground" ResourceKey="TextBrush" />
          <StaticResource x:Key="TextControlForegroundPointerOver" ResourceKey="TextBrush" />
          <StaticResource x:Key="TextControlForegroundFocused" ResourceKey="TextBrush" />
          <StaticResource x:Key="TextControlForegroundDisabled" ResourceKey="FaintTextBrush" />
          <StaticResource x:Key="TextControlPlaceholderForeground" ResourceKey="FaintTextBrush" />

          <StaticResource x:Key="ComboBoxBackground" ResourceKey="SurfaceBrush" />
          <StaticResource x:Key="ComboBoxBackgroundPointerOver" ResourceKey="SurfaceBrush" />
          <StaticResource x:Key="ComboBoxBackgroundPressed" ResourceKey="SurfaceBrush" />
          <StaticResource x:Key="ComboBoxBackgroundDisabled" ResourceKey="SidebarBrush" />
          <StaticResource x:Key="ComboBoxBorderBrush" ResourceKey="BorderBrushDefault" />
          <StaticResource x:Key="ComboBoxBorderBrushPointerOver" ResourceKey="BorderBrushStrong" />
          <StaticResource x:Key="ComboBoxBorderBrushPressed" ResourceKey="AccentBrush" />
          <StaticResource x:Key="ComboBoxBorderBrushDisabled" ResourceKey="BorderBrushSubtle" />
          <StaticResource x:Key="ComboBoxDropDownBackground" ResourceKey="RaisedBrush" />
          <StaticResource x:Key="ComboBoxDropDownBorderBrush" ResourceKey="BorderBrushDefault" />

          <StaticResource x:Key="ListBoxItemBackgroundPointerOver" ResourceKey="HoverBrush" />
          <StaticResource x:Key="ListBoxItemBackgroundSelected" ResourceKey="AccentTintBrush" />
          <StaticResource x:Key="ListBoxItemBackgroundSelectedPointerOver" ResourceKey="AccentTintBrush" />
          <StaticResource x:Key="ListBoxItemBackgroundSelectedPressed" ResourceKey="AccentTintBrush" />

          <StaticResource x:Key="ToolTipBackground" ResourceKey="RaisedBrush" />
          <StaticResource x:Key="ToolTipForeground" ResourceKey="TextBrush" />
          <StaticResource x:Key="ToolTipBorderBrush" ResourceKey="BorderBrushStrong" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- ── Base ─────────────────────────────────────────────────────────────── -->
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>

  <!-- Consistent control height (32) and radius (6) -->
  <Style Selector="Button, ToggleButton">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="NumericUpDown">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>

  <!-- Keyboard focus ring: one visible, consistent indicator on every interactive control -->
  <Style Selector="Button:focus-visible, ToggleButton:focus-visible, RadioButton:focus-visible, CheckBox:focus-visible, ComboBox:focus-visible, ListBoxItem:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!-- ── Typography ───────────────────────────────────────────────────────── -->
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="26" />
  </Style>
  <Style Selector="TextBlock.h">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.eyebrow">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource FaintTextBrush}" />
    <Setter Property="Margin" Value="12,14,0,4" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- ── Panels ───────────────────────────────────────────────────────────── -->
  <Style Selector="Border.panel, Border.card">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSubtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="16" />
  </Style>
  <Style Selector="Border.card">
    <Setter Property="Padding" Value="12" />
  </Style>
  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource BorderBrushSubtle}" />
  </Style>

  <!-- ── Buttons ──────────────────────────────────────────────────────────── -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource OnAccentBrush}" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource OnAccentBrush}" />
  </Style>
  <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSubtle}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource FaintTextBrush}" />
  </Style>

  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <Style Selector="Button.danger">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DangerTintBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerBrush}" />
  </Style>

  <Style Selector="Button.icon">
    <Setter Property="Width" Value="32" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <!-- Segmented switch (two or three mutually exclusive choices, e.g. controller layout) -->
  <Style Selector="RadioButton.seg">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="SegRoot" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}" MinHeight="{TemplateBinding MinHeight}">
          <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                            VerticalAlignment="Center" HorizontalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.seg:pointerover /template/ Border#SegRoot">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>
  <Style Selector="RadioButton.seg:checked /template/ Border#SegRoot">
    <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
  </Style>
  <Style Selector="RadioButton.seg:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentTextBrush}" />
    <Setter Property="TextElement.FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="RadioButton.seg:focus-visible /template/ Border#SegRoot">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!-- Sidebar navigation item -->
  <Style Selector="RadioButton.nav">
    <Setter Property="Height" Value="36" />
    <Setter Property="Margin" Value="8,1" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="NavRoot" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}" BorderThickness="0">
          <Grid ColumnDefinitions="3,*">
            <Border x:Name="NavBar" Width="3" Height="16" CornerRadius="2" Background="Transparent" HorizontalAlignment="Left" Margin="-10,0,0,0" />
            <ContentPresenter x:Name="PART_ContentPresenter" Grid.Column="1" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.nav:pointerover /template/ Border#NavRoot">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>
  <Style Selector="RadioButton.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="RadioButton.nav:checked /template/ Border#NavRoot">
    <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
  </Style>
  <Style Selector="RadioButton.nav:checked /template/ Border#NavBar">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="RadioButton.nav:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentTextBrush}" />
    <Setter Property="TextElement.FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="RadioButton.nav:focus-visible /template/ Border#NavRoot">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!-- ── Lists ────────────────────────────────────────────────────────────── -->
  <Style Selector="ListBox.plain">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.plain > ListBoxItem">
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Margin" Value="0,0,0,2" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Expander">
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="CheckBox, ToggleSwitch">
    <Setter Property="MinHeight" Value="28" />
  </Style>
  <Style Selector="ScrollViewer">
    <Setter Property="AllowAutoHide" Value="True" />
  </Style>

  <!-- ── Status dot ───────────────────────────────────────────────────────── -->
  <Style Selector="Ellipse.dot">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="Fill" Value="{DynamicResource FaintTextBrush}" />
  </Style>
  <Style Selector="Ellipse.dot.ok"><Setter Property="Fill" Value="{DynamicResource SuccessBrush}" /></Style>
  <Style Selector="Ellipse.dot.warn"><Setter Property="Fill" Value="{DynamicResource WarningBrush}" /></Style>
  <Style Selector="Ellipse.dot.err"><Setter Property="Fill" Value="{DynamicResource DangerBrush}" /></Style>
</Styles>
