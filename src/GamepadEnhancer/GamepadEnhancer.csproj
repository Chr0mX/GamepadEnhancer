<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows TFM: the rear paddles are read through Windows.Gaming.Input (Gamepad.GetCurrentReading). -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>GamepadEnhancer</AssemblyName>
    <RootNamespace>GamepadEnhancer</RootNamespace>
    <Version>1.1.0-beta</Version>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <!-- The default profile ships inside the app (read-only); profiles/Default.json is seeded from it on first run. -->
    <EmbeddedResource Include="Defaults\Default.json" LogicalName="GamepadEnhancer.Default.json" />
    <!-- One file per controller layout: brand labels live here and nowhere else. Add a file to add a layout. -->
    <EmbeddedResource Include="Defaults\Controllers\*.json" LogicalName="GamepadEnhancer.Controllers.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Defaults\DefaultXbox.json" LogicalName="GamepadEnhancer.DefaultXbox.json" />
    <!-- The built-in Apex layout (keyboard + mouse, PS4 pad); always loaded from here, never from profiles/. -->
    <EmbeddedResource Include="Defaults\Apex.json" LogicalName="GamepadEnhancer.Apex.json" />
    <!-- One JSON file per supported game (name, source of the defaults, native controller labels, default profile). Add a file to add a game. -->
    <EmbeddedResource Include="Defaults\Games\*.json" LogicalName="GamepadEnhancer.Games.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.2.3" />
    <PackageReference Include="Nefarius.ViGEm.Client" Version="1.21.256" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GamepadEnhancer.Tests" />
  </ItemGroup>

</Project>
