<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:GamepadEnhancer"
        x:Class="GamepadEnhancer.MainWindow"
        Title="GamepadEnhancer"
        Width="1280" Height="820" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        Background="{DynamicResource CanvasBrush}">

  <Grid RowDefinitions="*,Auto">
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*">

      <!-- ═══════════════ Navigation rail ═══════════════ -->
      <Border x:Name="sidebar" Grid.Column="0" Width="64" Background="{DynamicResource SidebarBrush}"
              BorderBrush="{DynamicResource BorderBrushSubtle}" BorderThickness="0,0,1,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,16,0,16" HorizontalAlignment="Center">
          <Border Padding="8" CornerRadius="12" Margin="0,0,0,24" Background="{DynamicResource AccentTintBrush}" BorderBrush="{DynamicResource AccentLineBrush}" BorderThickness="1" HorizontalAlignment="Center" ToolTip.Tip="GamepadEnhancer">
            <v:Icon Kind="gamepad" Width="24" Height="24" Foreground="{DynamicResource AccentBrush}" />
          </Border>
          <RadioButton x:Name="navDashboard" Classes="nav" GroupName="nav" Tag="dashboard" IsChecked="True" ToolTip.Tip="Dashboard" IsCheckedChanged="Nav_Changed"><v:Icon Kind="dashboard" Width="20" Height="20" /></RadioButton>
          <RadioButton Classes="nav" GroupName="nav" Tag="controller" ToolTip.Tip="Controller mapping" IsCheckedChanged="Nav_Changed"><v:Icon Kind="gamepad" Width="20" Height="20" /></RadioButton>
          <RadioButton Classes="nav" GroupName="nav" Tag="bindings" ToolTip.Tip="Bindings: conditions, toggle, outputs" IsCheckedChanged="Nav_Changed"><v:Icon Kind="key" Width="20" Height="20" /></RadioButton>
          <RadioButton Classes="nav" GroupName="nav" Tag="games" ToolTip.Tip="Games and profiles" IsCheckedChanged="Nav_Changed"><v:Icon Kind="games" Width="20" Height="20" /></RadioButton>
          <RadioButton Classes="nav" GroupName="nav" Tag="paddles" ToolTip.Tip="Rear paddles" IsCheckedChanged="Nav_Changed"><v:Icon Kind="paddles" Width="20" Height="20" /></RadioButton>
          <RadioButton Classes="nav" GroupName="nav" Tag="mouse" ToolTip.Tip="Mouse look (right stick)" IsCheckedChanged="Nav_Changed"><v:Icon Kind="mouse" Width="20" Height="20" /></RadioButton>
          <Border Classes="divider" Margin="12,8" />
          <RadioButton x:Name="navMonitor" Classes="nav" GroupName="nav" Tag="monitor" ToolTip.Tip="Controller monitor" IsCheckedChanged="Nav_Changed"><v:Icon Kind="activity" Width="20" Height="20" /></RadioButton>
          <RadioButton Classes="nav" GroupName="nav" Tag="network" ToolTip.Tip="Network and input" IsCheckedChanged="Nav_Changed"><v:Icon Kind="network" Width="20" Height="20" /></RadioButton>
        </StackPanel>
        </ScrollViewer>
      </Border>

      <Grid Grid.Column="1" RowDefinitions="Auto,*">

        <!-- ═══════════════ Header: identity, state tags, controller type, connect ═══════════════ -->
        <Border x:Name="headerBar" Grid.Row="0" Height="56" Padding="24,0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrushSubtle}" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto,Auto">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="0,0,14,0">
              <TextBlock x:Name="brandText" Classes="pagetitle" Text="GamepadEnhancer" VerticalAlignment="Center" />
              <Border Width="1" Height="16" Background="{DynamicResource BorderBrushDefault}" VerticalAlignment="Center" />
              <TextBlock x:Name="versionText" Classes="mono" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <Border Grid.Column="1" Classes="pill" Margin="0,0,6,0"><v:StatusBadge x:Name="statusBarBadge" /></Border>
            <Border x:Name="tagOutput" Grid.Column="2" Classes="tag" Margin="0,0,4,0"><TextBlock x:Name="tagOutputText" Text="VIGEM" /></Border>
            <Border x:Name="tagCapture" Grid.Column="3" Classes="tag" Margin="0,0,4,0"><TextBlock x:Name="tagCaptureText" Text="HOOKS" /></Border>
            <Border x:Name="tagNetwork" Grid.Column="4" Classes="tag" Margin="0,0,6,0"><TextBlock x:Name="tagNetworkText" Text="NET API" /></Border>
            <Button x:Name="headerConfigPill" Grid.Column="5" Classes="soft" ToolTip.Tip="Profile menu: load, save, save as, rename, delete, import, export"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock x:Name="statusBarConfig" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="260" /><TextBlock Text="▾" VerticalAlignment="Center" /></StackPanel></Button>
            <Border Grid.Column="7" Classes="segbox" Margin="0,0,8,0"><StackPanel x:Name="layoutSwitch" Orientation="Horizontal" Spacing="2" /></Border>
            <StackPanel Grid.Column="8" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Button x:Name="connectButton" Classes="soft" Content="Connect" Click="ConnectButton_Click" />
              <Button x:Name="disconnectButton" Content="Disconnect" IsEnabled="False" IsVisible="False" Click="DisconnectButton_Click" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- Kept as models for the controller type, the output text and the page name -->
        <StackPanel IsVisible="False">
          <ComboBox x:Name="controllerTypeBox" />
          <TextBlock x:Name="activeControllerLabel" />
          <TextBlock x:Name="pageTitleText" />
        </StackPanel>

        <!-- ═══════════════ Pages ═══════════════ -->
        <Grid Grid.Row="1" x:Name="pagesHost">

          <!-- ───────── Dashboard ───────── -->
          <ScrollViewer x:Name="pageDashboard" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid x:Name="dashGrid" Margin="16,16,4,4" MaxWidth="1600" HorizontalAlignment="Stretch"
                  ColumnDefinitions="*,*,*,*,*,*,*,*,*,*,*,*">

              <v:Section x:Name="cardStickL" Title="LEFT STICK">
                <v:StickPlot x:Name="plotL" Height="230" />
              </v:Section>
              <v:Section x:Name="cardStickR" Title="RIGHT STICK">
                <v:StickPlot x:Name="plotR" Height="230" />
              </v:Section>

              <!-- Virtual controller -->
              <v:Section x:Name="cardVirtual" Title="VIRTUAL CONTROLLER">
                <StackPanel>
                  <UniformGrid Columns="2">
                    <Border Classes="tile" Margin="0,0,6,6"><StackPanel><TextBlock Classes="tilelab" Text="STATE" /><v:StatusBadge x:Name="dashVirtualBadge" Margin="0,3,0,0" /></StackPanel></Border>
                    <Border Classes="tile" Margin="6,0,0,6"><StackPanel><TextBlock Classes="tilelab" Text="OUTPUT RATE" /><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock x:Name="dashRateText" Classes="val blue" Text="0" /><TextBlock Classes="unit" Text="reports/s" VerticalAlignment="Bottom" Margin="0,0,0,3" /></StackPanel></StackPanel></Border>
                    <Border Classes="tile" Margin="0,6,6,0"><StackPanel><TextBlock Classes="tilelab" Text="TYPE" /><TextBlock x:Name="dashVirtualTitle" Classes="val purple" FontSize="13" /></StackPanel></Border>
                    <Border Classes="tile" Margin="6,6,0,0"><StackPanel><TextBlock Classes="tilelab" Text="PATH" /><v:StatusBadge x:Name="dashOutputBadge" Margin="0,3,0,0" /></StackPanel></Border>
                  </UniformGrid>
                  <TextBlock x:Name="dashVirtualDetail" Classes="caption" Margin="0,10,0,0" />
                  <TextBlock x:Name="dashOutputDetail" Classes="caption" Margin="0,2,0,0" />
                </StackPanel>
              </v:Section>

              <!-- Details: key / value rows, like an inspector -->
              <v:Section x:Name="cardConfig" Title="DETAILS">
                <StackPanel>
                  <TextBlock Classes="tilelab" Text="CONFIGURATION" Margin="0,0,0,6" />
                  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6"><TextBlock Classes="caption" Text="Game" VerticalAlignment="Center" /><TextBlock x:Name="dashConfigText" Classes="mono" Grid.Column="1" TextTrimming="CharacterEllipsis" MaxWidth="170" /></Grid>
                  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6"><TextBlock Classes="caption" Text="Loaded" VerticalAlignment="Center" /><TextBlock x:Name="dashConfigDetail" Classes="mono" Grid.Column="1" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="170" /></Grid>
                  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6"><TextBlock Classes="caption" Text="Profile" VerticalAlignment="Center" /><TextBlock x:Name="dashProfileTitle" Classes="mono" Grid.Column="1" TextTrimming="CharacterEllipsis" MaxWidth="170" /></Grid>
                  <Border Classes="divider" Margin="0,4,0,10" />
                  <TextBlock Classes="tilelab" Text="INPUT AND NETWORK" Margin="0,0,0,6" />
                  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6"><TextBlock Classes="caption" Text="Physical pad" VerticalAlignment="Center" /><v:StatusBadge x:Name="dashPhysicalBadge" Grid.Column="1" /></Grid>
                  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6"><TextBlock Classes="caption" Text="Network API" VerticalAlignment="Center" /><v:StatusBadge x:Name="dashNetworkBadge" Grid.Column="1" /></Grid>
                  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6"><TextBlock Classes="caption" Text="Capture" VerticalAlignment="Center" /><TextBlock x:Name="dashCaptureText" Classes="mono" Grid.Column="1" Foreground="{DynamicResource ValueOrangeBrush}" /></Grid>
                  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6"><TextBlock Classes="caption" Text="Mouse look" VerticalAlignment="Center" /><TextBlock x:Name="dashMouseText" Classes="mono" Grid.Column="1" Foreground="{DynamicResource ValueGreenBrush}" /></Grid>
                  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6"><TextBlock Classes="caption" Text="Rear paddles" VerticalAlignment="Center" /><TextBlock x:Name="dashPaddleText" Classes="mono" Grid.Column="1" Foreground="{DynamicResource ValueGreenBrush}" /></Grid>
                  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6"><TextBlock Classes="caption" Text="Input blocking" VerticalAlignment="Center" /><TextBlock x:Name="dashBlockText" Classes="mono" Grid.Column="1" Foreground="{DynamicResource ValueOrangeBrush}" /></Grid>
                  <TextBlock x:Name="dashPhysicalDetail" Classes="caption" Margin="0,4,0,0" />
                  <TextBlock x:Name="dashNetworkDetail" Classes="caption" Margin="0,2,0,0" />
                  <TextBlock x:Name="dashProfileText" Classes="caption" Margin="0,2,0,0" />
                </StackPanel>
              </v:Section>

              <!-- Pad picture -->
              <v:Section x:Name="cardPad" Title="CONTROLLER">
                <v:Section.Actions>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Content="Open mapping" Classes="soft" Tag="controller" Click="GoTo_Click" />
                    <Button Content="Games" Tag="games" Click="GoTo_Click" />
                  </StackPanel>
                </v:Section.Actions>
                <Border x:Name="dashPadHost" Height="300" MinHeight="220" />
              </v:Section>

              <!-- Triggers -->
              <v:Section x:Name="cardAxes" Title="TRIGGERS">
                <StackPanel Spacing="10">
                  <StackPanel Spacing="4"><TextBlock x:Name="dashLtLabel" Classes="tilelab" Text="LT" /><v:BarMeter x:Name="barLt" Height="24" ColorKey="ValueBlueBrush" /></StackPanel>
                  <StackPanel Spacing="4"><TextBlock x:Name="dashRtLabel" Classes="tilelab" Text="RT" /><v:BarMeter x:Name="barRt" Height="24" ColorKey="DangerBrush" /></StackPanel>
                  <UniformGrid Columns="2">
                    <Border Classes="tile" Margin="0,0,6,0"><StackPanel><TextBlock Classes="tilelab" Text="LEFT STICK" /><TextBlock x:Name="dashLeftStick" Classes="val" FontSize="12" Text="+0.00  +0.00" /></StackPanel></Border>
                    <Border Classes="tile" Margin="6,0,0,0"><StackPanel><TextBlock Classes="tilelab" Text="RIGHT STICK" /><TextBlock x:Name="dashRightStick" Classes="val" FontSize="12" Text="+0.00  +0.00" /></StackPanel></Border>
                  </UniformGrid>
                  <TextBlock Classes="caption" Text="Final output sent to the virtual pad; zero while nothing is connected." />
                </StackPanel>
              </v:Section>

              <!-- Event stream -->
              <v:Section x:Name="cardEvents" Title="EVENT STREAM" Description="Button presses and releases on the final output, newest first.">
                <TextBlock x:Name="dashEventLog" Classes="mono" TextWrapping="NoWrap" MinHeight="200" />
              </v:Section>
            </Grid>
          </ScrollViewer>

          <!-- ───────── Controller ───────── -->
          <ScrollViewer x:Name="pageController" IsVisible="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,12,16,16" Spacing="12" MaxWidth="1560" HorizontalAlignment="Stretch">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Border Classes="segbox">
                  <StackPanel Orientation="Horizontal" Spacing="2">
                    <RadioButton Classes="seg" GroupName="ctab" Tag="buttons" IsChecked="True" Content="Buttons" IsCheckedChanged="CTab_Changed" />
                    <RadioButton Classes="seg" GroupName="ctab" Tag="sticks" Content="Sticks" IsCheckedChanged="CTab_Changed" />
                    <RadioButton Classes="seg" GroupName="ctab" Tag="all" Content="All bindings" IsCheckedChanged="CTab_Changed" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="segbox" HorizontalAlignment="Right" Padding="12,6">
                  <TextBlock x:Name="activeGameLabel" Classes="caption" TextTrimming="CharacterEllipsis" />
                </Border>
                <Button Grid.Column="2" Classes="danger" VerticalAlignment="Center" Click="RestoreGameDefaults_Click" ToolTip.Tip="Discard your changes to the selected config and go back to its built-in defaults.">
                  <StackPanel Orientation="Horizontal" Spacing="8"><v:Icon Kind="restore" /><TextBlock Text="Reset defaults" /></StackPanel>
                </Button>
              </Grid>

              <StackPanel x:Name="controllerMapPane" Spacing="12">
              <Grid x:Name="controllerGrid" ColumnDefinitions="*,12,310" RowDefinitions="Auto,Auto">
                <Border x:Name="diagramPanel" Grid.Column="0" Classes="panel" Padding="0" ClipToBounds="True">
                  <Grid RowDefinitions="*,Auto">
                    <Border x:Name="diagramHost" Height="580" MinHeight="320" />
                    <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrushDefault}" BorderThickness="0,1,0,0" Padding="16,10">
                      <TextBlock x:Name="diagramHint" Classes="caption" TextWrapping="Wrap"
                                 Text="Click a button or stick direction on the controller, or its label, then press the key, mouse button or wheel notch you want for it." />
                    </Border>
                  </Grid>
                </Border>
                <Border x:Name="inspectorHostController" Grid.Column="2" />
              </Grid>

              <TextBlock x:Name="activeGameSourceLabel" Classes="caption" />
              </StackPanel>

              <StackPanel x:Name="allBindingsPane" IsVisible="False" Spacing="12">
                <StackPanel Spacing="12">
                  <v:Section Title="Buttons" Description="Bind each pad button to a keyboard key, a mouse button or a mouse wheel notch. Turbo (rapid fire) is optional per button. Ultimate Ability in Apex is L1 + R1 together.">
                    <UniformGrid x:Name="bindingsGrid" Columns="2" />
                  </v:Section>
                  <v:Section Title="Left stick · keyboard" Description="Four keyboard keys move the left stick. Opposite keys cancel out and diagonals are scaled so they are no faster than straight lines. A left stick value sent over the Network API replaces these keys while it is set.">
                    <UniformGrid x:Name="leftStickGrid" Columns="2" />
                  </v:Section>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>

          <!-- Shared editor for the selected control (moves between the Controller and Rear paddles pages) -->
          <Border x:Name="inspectorCard" Classes="panel" IsVisible="False">
            <StackPanel Spacing="12">
              <StackPanel Spacing="2">
                <TextBlock Classes="lab" Text="SELECTED INPUT" />
                <TextBlock x:Name="slotTitle" Classes="stat" Text="Select a control" />
              </StackPanel>
              <TextBlock x:Name="slotNative" Classes="caption" />
              <WrapPanel x:Name="slotPickerRow" Orientation="Horizontal" />
              <WrapPanel x:Name="slotCaptureRow" Orientation="Horizontal" IsVisible="False">
                <Button x:Name="slotCaptureButton" Classes="primary" Content="Press a key or button..." Margin="0,0,10,4"
                        ToolTip.Tip="Click, then press the keyboard key, mouse button or wheel notch you want. Esc cancels." />
                <TextBlock Classes="caption" VerticalAlignment="Center" Margin="0,0,0,4" Text="or choose from the list" />
              </WrapPanel>
              <WrapPanel x:Name="slotTurboRow" Orientation="Horizontal" IsVisible="False">
                <CheckBox x:Name="slotTurboBox" Content="Turbo" Margin="0,0,8,4" />
                <NumericUpDown x:Name="slotTurboHz" Minimum="1" Maximum="30" Value="12" Increment="1" FormatString="0" MinWidth="100" Margin="0,0,6,4" />
                <TextBlock Text="Hz" VerticalAlignment="Center" Margin="0,0,0,4" />
              </WrapPanel>
              <WrapPanel x:Name="paddleRow" Orientation="Horizontal" IsVisible="False">
                <CheckBox x:Name="paddleEnableBox" Content="Enable this paddle" Margin="0,0,12,4" />
                <Button x:Name="paddleLearnButton" Content="Detect paddle..." Margin="0,0,0,4" ToolTip.Tip="Press the physical paddle you want to use for this slot." />
              </WrapPanel>
              <TextBlock x:Name="paddleStatusLabel" Classes="caption" />
              <TextBlock x:Name="slotHint" Classes="caption" />
            </StackPanel>
          </Border>

          <!-- Model for the game list (the Games page ListBox is the visible selector); kept so game switching logic stays unchanged -->
          <ComboBox x:Name="gameComboBox" IsVisible="False" SelectionChanged="GameComboBox_SelectionChanged" />

          <!-- ───────── Games and profiles ───────── -->
          <ScrollViewer x:Name="pageGames" IsVisible="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid x:Name="gamesGrid" Margin="16,12,16,20" ColumnDefinitions="320,12,*" MaxWidth="1500" HorizontalAlignment="Stretch">
              <StackPanel x:Name="gamesLeft" Grid.Column="0" Spacing="12">
                <v:Section x:Name="gameListSection" Title="Games" Description="Picking a game loads its default layout. Each game keeps its own changes automatically; built-in defaults are never overwritten.">
                  <ListBox x:Name="gameList" Classes="plain" SelectionChanged="GameList_SelectionChanged" />
                </v:Section>
                <v:Section x:Name="profileSection" Title="Profile" Description="A profile is a saved copy of your setup: controller type, bindings, paddles and mouse look. Load, save and manage them from this menu (also in the header).">
                  <StackPanel Spacing="12">
                    <TextBlock x:Name="profileActiveLabel" Classes="label" TextWrapping="Wrap" />
                    <Button x:Name="profileMenuButton" Classes="primary" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal" Spacing="8"><v:Icon Kind="save" /><TextBlock Text="Profile menu" /><TextBlock Text="▾" /></StackPanel></Button>
                    <TextBlock x:Name="profileInfoLabel" Classes="caption" TextWrapping="Wrap" />
                  </StackPanel>
                </v:Section>
              </StackPanel>

              <v:Section x:Name="gameDetailSection" Grid.Column="2" Title="Mapping overview" Description="What the game does on each pad button, and the PC input this app maps to it.">
                <v:Section.Actions>
                  <Button Click="RestoreGameDefaults_Click" ToolTip.Tip="Discard your changes to the selected config and go back to its built-in defaults.">
                    <StackPanel Orientation="Horizontal" Spacing="8"><v:Icon Kind="restore" /><TextBlock Text="Restore defaults" /></StackPanel>
                  </Button>
                </v:Section.Actions>
                <StackPanel Spacing="12">
                  <TextBlock x:Name="gameDetailName" Classes="stat" />
                  <WrapPanel x:Name="gameDetailBadges" />
                  <TextBlock x:Name="gameDetailSource" Classes="caption" />
                  <Border Classes="divider" />
                  <TextBlock x:Name="gameNativeEmpty" Classes="caption" IsVisible="False" />
                  <ItemsControl x:Name="gameNativeList" />
                </StackPanel>
              </v:Section>
            </Grid>
          </ScrollViewer>

          <!-- ───────── Rear paddles ───────── -->
          <ScrollViewer x:Name="pagePaddles" IsVisible="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,12,16,20" Spacing="12" MaxWidth="1560" HorizontalAlignment="Stretch">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="caption" VerticalAlignment="Center" Text="Four independent paddles. Each can press a virtual controller button, a keyboard key or a mouse button. They need a physical controller that has paddles." />
                <v:StatusBadge x:Name="paddleHwBadge" Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0" />
              </Grid>
              <Grid x:Name="paddleGrid" ColumnDefinitions="*,12,310">
                <Border x:Name="paddleDiagramPanel" Classes="panel" Padding="0" Grid.Column="0" ClipToBounds="True">
                  <Border x:Name="paddleDiagramHost" Height="520" MinHeight="320" />
                </Border>
                <StackPanel x:Name="paddleSidePanel" Grid.Column="2" Spacing="12">
                  <Border x:Name="inspectorHostPaddles" />
                  <v:Section Title="Overview" Description="Click a row to edit that paddle. The dot lights while the physical paddle is held.">
                    <StackPanel x:Name="paddleSummary" Spacing="4" />
                  </v:Section>
                </StackPanel>
              </Grid>
            </StackPanel>
          </ScrollViewer>

          <!-- ───────── Mouse look ───────── -->
          <ScrollViewer x:Name="pageMouse" IsVisible="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid x:Name="mouseGrid" Margin="16,12,16,20" ColumnDefinitions="*,12,360" MaxWidth="1300" HorizontalAlignment="Stretch">
              <StackPanel x:Name="mouseLeft" Grid.Column="0" Spacing="12">
              <TextBlock Classes="caption" Text="The right stick is not bound to a key: moving the mouse moves the stick. A stick value sent over the Network API replaces it while set. Movement is read with Raw Input, so it works with either input capture method." />
              <v:Section Title="Mouse look">
                <v:SettingRow Title="Mouse movement drives the right stick" Description="Mouse Up / Down / Left / Right = stick up / down / left / right.">
                  <ToggleSwitch x:Name="mouseLookBox" OnContent="" OffContent="" IsCheckedChanged="AnySettingChangedChecked" />
                </v:SettingRow>
              </v:Section>
              <v:Section Title="Mouse movement" Description="Sensitivity is percent of stick per (mouse count per millisecond): a higher value means a slower mouse reaches full tilt.">
                <StackPanel>
                  <v:SettingRow Title="Sensitivity X" Description="Horizontal sensitivity.">
                    <NumericUpDown x:Name="mouseSensXBox" Minimum="0.5" Maximum="100" Value="8" Increment="0.5" FormatString="0.0" MinWidth="130" ValueChanged="AnySettingChangedNumeric" />
                  </v:SettingRow>
                  <v:SettingRow Title="Sensitivity Y" Description="Vertical sensitivity.">
                    <NumericUpDown x:Name="mouseSensYBox" Minimum="0.5" Maximum="100" Value="8" Increment="0.5" FormatString="0.0" MinWidth="130" ValueChanged="AnySettingChangedNumeric" />
                  </v:SettingRow>
                  <v:SettingRow Title="Curve" Description="Response curve of small versus large movements.">
                    <NumericUpDown x:Name="mouseCurveBox" Minimum="0.5" Maximum="4" Value="1" Increment="0.1" FormatString="0.0" MinWidth="130" ValueChanged="AnySettingChangedNumeric" />
                  </v:SettingRow>
                  <v:SettingRow Title="Invert Y" Description="Moving the mouse up pushes the stick down.">
                    <ToggleSwitch x:Name="mouseInvertYBox" OnContent="" OffContent="" IsCheckedChanged="AnySettingChangedChecked" />
                  </v:SettingRow>
                </StackPanel>
              </v:Section>
              <v:Section Title="Right-stick output">
                <StackPanel>
                  <v:SettingRow Title="Game dead zone (%)" Description="Set this to the game's own inner stick dead zone so small mouse moves still register.">
                    <NumericUpDown x:Name="mouseDeadZoneBox" Minimum="0" Maximum="50" Value="0" Increment="1" FormatString="0" MinWidth="130" ValueChanged="AnySettingChangedNumeric" />
                  </v:SettingRow>
                  <v:SettingRow Title="Release (ms)" Description="How long the last stick value is held with no movement before the stick recenters.">
                    <NumericUpDown x:Name="mouseReleaseBox" Minimum="0" Maximum="500" Value="30" Increment="5" FormatString="0" MinWidth="130" ValueChanged="AnySettingChangedNumeric" />
                  </v:SettingRow>
                </StackPanel>
              </v:Section>
              </StackPanel>
              <StackPanel x:Name="mouseRight" Grid.Column="2" Spacing="12">
                <v:Section Title="Response curve" Description="Stick output against mouse speed, drawn with the same function the engine uses. Dashed: linear. The short tick on the left is the game dead zone.">
                  <v:CurvePlot x:Name="curvePlot" Height="210" />
                </v:Section>
                <v:Section Title="Right stick output" Description="The final right-stick value sent to the virtual pad. Centred while nothing is connected. The dashed ring is the game dead zone.">
                  <v:StickScope x:Name="stickScope" Height="230" />
                </v:Section>
              </StackPanel>
            </Grid>
          </ScrollViewer>
          <!-- ───────── Monitor ───────── -->
          <ScrollViewer x:Name="pageMonitor" IsVisible="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,12,16,20" Spacing="12" MaxWidth="1560" HorizontalAlignment="Stretch">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="caption" VerticalAlignment="Center" Text="The three stages of the pipeline side by side. It draws on its own timer and never delays the controller output." />
                <Button x:Name="monitorPopoutButton" Grid.Column="1" Content="Open pop-out window" Click="MonitorPopout_Click" />
              </Grid>

              <Grid x:Name="monitorStages" ColumnDefinitions="*,12,*,12,*">
                <Border x:Name="monitorStagePhysical" Classes="panel" Grid.Column="0" Padding="12">
                  <StackPanel Spacing="2"><TextBlock Classes="lab" Text="1 · PHYSICAL INPUT" /><TextBlock Classes="caption" Text="what the keyboard and mouse ask for" /><Border x:Name="monitorHostPhysical" HorizontalAlignment="Center" /></StackPanel>
                </Border>
                <Border x:Name="monitorStageProcessed" Classes="panel" Grid.Column="2" Padding="12">
                  <StackPanel Spacing="2"><TextBlock Classes="lab" Text="2 · PROCESSED" /><TextBlock Classes="caption" Text="after mouse look, turbo and remote commands" /><Border x:Name="monitorHostProcessed" HorizontalAlignment="Center" /></StackPanel>
                </Border>
                <Border x:Name="monitorStageFinal" Classes="panel" Grid.Column="4" Padding="12">
                  <StackPanel Spacing="2"><TextBlock Classes="lab" Text="3 · FINAL OUTPUT" /><TextBlock Classes="caption" Text="exactly what is sent to the virtual pad" /><Border x:Name="monitorHostFinal" HorizontalAlignment="Center" /></StackPanel>
                </Border>
              </Grid>

              <v:Section Title="Display and pop-out">
                <StackPanel>
                  <v:SettingRow Title="Live visualization" Description="Turn off to stop drawing entirely.">
                    <ToggleSwitch x:Name="monitorEnabledBox" IsChecked="True" OnContent="" OffContent="" IsCheckedChanged="MonitorSettings_Checked" />
                  </v:SettingRow>
                  <v:SettingRow Title="Size (%)" Description="The controllers shrink further when the window is narrow.">
                    <NumericUpDown x:Name="monitorScaleBox" Minimum="50" Maximum="200" Value="100" Increment="10" FormatString="0" MinWidth="130" ValueChanged="MonitorSettings_Numeric" />
                  </v:SettingRow>
                  <v:SettingRow Title="Refresh (Hz)">
                    <ComboBox x:Name="monitorHzBox" MinWidth="110" SelectionChanged="MonitorSettings_SelectionChanged" />
                  </v:SettingRow>
                  <v:SettingRow Title="Compact" Description="No button names and no event history.">
                    <ToggleSwitch x:Name="monitorCompactBox" OnContent="" OffContent="" IsCheckedChanged="MonitorSettings_Checked" />
                  </v:SettingRow>
                  <v:SettingRow Title="Pop-out window shows" Description="Which stage the separate pop-out window displays.">
                    <ComboBox x:Name="monitorViewBox" MinWidth="220" SelectionChanged="MonitorSettings_SelectionChanged" />
                  </v:SettingRow>
                  <TextBlock x:Name="monitorViewHint" Classes="caption" Margin="0,6,0,0" />
                  <v:SettingRow Title="Pop-out always on top" Description="Keep the pop-out window above the game.">
                    <ToggleSwitch x:Name="monitorTopmostBox" OnContent="" OffContent="" IsCheckedChanged="MonitorSettings_Checked" />
                  </v:SettingRow>
                  <v:SettingRow Title="Pop-out as transparent overlay" Description="No frame, only the controller. Drag to move; Esc or right click closes it.">
                    <ToggleSwitch x:Name="monitorOverlayBox" OnContent="" OffContent="" IsCheckedChanged="MonitorSettings_Checked" />
                  </v:SettingRow>
                </StackPanel>
              </v:Section>
            </StackPanel>
          </ScrollViewer>

          <!-- ───────── Bindings ───────── -->
          <ScrollViewer x:Name="pageBindings" IsVisible="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,12,16,24" Spacing="12" MaxWidth="1200" HorizontalAlignment="Stretch">
              <TextBlock Classes="caption" Text="A binding connects one input to one or more outputs. The condition decides when it runs and whether it repeats; Toggle latches a run-once binding on and off. Enabled means eligible to run; a highlighted row means it is running right now." />
              <WrapPanel>
                <Button Classes="primary" Margin="0,0,8,6" Click="AddBinding_Click"><StackPanel Orientation="Horizontal" Spacing="8"><v:Icon Kind="plus" /><TextBlock Text="Add binding" /></StackPanel></Button>
                <Button x:Name="pasteBindingButton" Margin="0,0,8,6" IsEnabled="False" Click="PasteBinding_Click"><StackPanel Orientation="Horizontal" Spacing="8"><v:Icon Kind="copy" /><TextBlock Text="Paste binding" /></StackPanel></Button>
                <TextBlock x:Name="bindingsSummary" Classes="caption" VerticalAlignment="Center" Margin="8,0,0,6" />
              </WrapPanel>
              <StackPanel x:Name="bindingsList" Spacing="8" />
              <TextBlock x:Name="bindingsEmpty" Classes="caption" Text="No bindings yet. Add one, then press the key or mouse button to use as its input." />
              <v:Section Title="Automatic bindings" Description="Your normal controller mappings (Controller page) are the automatic bindings.">
                <TextBlock x:Name="bindingsAutoText" Classes="caption" TextWrapping="Wrap" />
              </v:Section>
              <v:Section Title="How layers work" Description="A layer is an alternate set of bindings that you switch on with a shift key, like Shift on a keyboard.">
                <TextBlock Classes="caption" TextWrapping="Wrap" Text="Normally the Base layer is the only thing running. A binding set to Layer 1, 2 or 3 does nothing until that layer is switched on, and while it is on it takes over its input from the base binding. Example: (1) Add a binding: input Right Mouse, condition Held, then Details > Add output > Layer (shift) > Layer 1. That is your shift key. (2) Add a second binding: input Space, output Pad button Circle, and set its layer selector to Layer 1. Now Space does whatever its base binding does, but while you hold Right Mouse it presses Circle instead; let go and it is back to normal. For a shift that stays on, use Press + Toggle instead of Held: press once to switch the layer on, press again to switch it off. A Layer 1-3 binding with no outputs un-maps that input while the layer is on. The status On another layer means the binding exists but its layer is not on right now." />
              </v:Section>
              <TextBlock Classes="caption" Text="Condition timing runs on the controller output tick (10 ms), so Tap, Double and Hold are accurate to about 10 ms." />
            </StackPanel>
          </ScrollViewer>

          <!-- ───────── Network and input ───────── -->
          <ScrollViewer x:Name="pageNetwork" IsVisible="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,12,16,24" Spacing="12" MaxWidth="1500" HorizontalAlignment="Stretch">
              <TextBlock Classes="caption" Text="Two directions. Receive: another computer controls the controller on this PC. Send: this PC's keyboard and mouse drive a controller on another PC. Input is how keyboard and mouse are read and when they are blocked." />
              <Border BorderBrush="{DynamicResource BorderBrushDefault}" BorderThickness="0,0,0,1" Padding="4,0">
                <StackPanel Orientation="Horizontal">
                  <RadioButton Classes="tab" GroupName="ntab" Tag="recv" IsChecked="True" Content="RECEIVE" IsCheckedChanged="NTab_Changed" />
                  <RadioButton Classes="tab" GroupName="ntab" Tag="send" Content="SEND" IsCheckedChanged="NTab_Changed" />
                  <RadioButton Classes="tab" GroupName="ntab" Tag="input" Content="INPUT AND BLOCKING" IsCheckedChanged="NTab_Changed" />
                  <RadioButton Classes="tab" GroupName="ntab" Tag="look" Content="APPEARANCE AND FILES" IsCheckedChanged="NTab_Changed" />
                </StackPanel>
              </Border>
              <StackPanel x:Name="networkGrid" MaxWidth="820" HorizontalAlignment="Left" Spacing="12">
                <v:Section x:Name="netReceiveSection" Title="Receive · Network API" Description="Another computer drives this virtual controller with MAKCU-style text commands over TCP: km.controller(id,value[,hold_ms]), km.controller_clear(). A client can also subscribe to this PC's mouse buttons with km.mouse_stream(1).">
                  <StackPanel>
                    <v:SettingRow Title="Enable Network API" Description="Off by default. Connect the controller first.">
                      <ToggleSwitch x:Name="netEnabledBox" OnContent="" OffContent="" IsCheckedChanged="NetworkSettings_Changed" />
                    </v:SettingRow>
                    <v:SettingRow Title="Port">
                      <TextBox x:Name="netPortBox" Width="110" Text="5555" LostFocus="NetworkSettings_LostFocus" />
                    </v:SettingRow>
                    <v:SettingRow Title="Allow other computers (LAN)" Description="Off keeps it reachable from this PC only.">
                      <ToggleSwitch x:Name="netBindAllBox" IsChecked="True" OnContent="" OffContent="" IsCheckedChanged="NetworkSettings_Changed" />
                    </v:SettingRow>
                    <v:SettingRow Title="Token" Description="A client sends auth &lt;token&gt; first. Anyone on your network who has it can control the pad, so keep the port firewalled.">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBox x:Name="netTokenBox" Width="130" IsReadOnly="True" PasswordChar="●" />
                        <CheckBox x:Name="netShowTokenBox" Content="Show" IsCheckedChanged="NetShowToken_Changed" />
                      </StackPanel>
                    </v:SettingRow>
                    <WrapPanel Margin="0,10,0,0">
                      <Button x:Name="netCopyButton" Margin="0,0,8,8" Click="NetCopyToken_Click"><StackPanel Orientation="Horizontal" Spacing="8"><v:Icon Kind="copy" /><TextBlock Text="Copy token" /></StackPanel></Button>
                      <Button x:Name="netNewTokenButton" Margin="0,0,8,8" Click="NetNewToken_Click"><StackPanel Orientation="Horizontal" Spacing="8"><v:Icon Kind="restore" /><TextBlock Text="New token" /></StackPanel></Button>
                    </WrapPanel>
                    <v:StatusBadge x:Name="netStatusBadge" Margin="0,4,0,4" />
                    <TextBlock x:Name="netStatusLabel" Classes="caption" Text="Network API is off" />
                  </StackPanel>
                </v:Section>

                <v:Section x:Name="netSendSection" IsVisible="False" Title="Send · to another PC" Description="Run this app on the PC with your mouse and keyboard and let the other PC (the one with ViGEmBus and the game) create the virtual controller. Enter that PC's address and token from its Network page, then press Connect. No ViGEmBus is needed on this PC.">
                  <StackPanel>
                    <v:SettingRow Title="Send the controller to another PC" Description="Instead of creating it on this PC.">
                      <ToggleSwitch x:Name="remoteSendBox" OnContent="" OffContent="" IsCheckedChanged="RemoteSettings_Changed" />
                    </v:SettingRow>
                    <v:SettingRow Title="Address">
                      <TextBox x:Name="remoteHostBox" Width="170" Watermark="192.168.1.20" LostFocus="RemoteSettings_LostFocus" />
                    </v:SettingRow>
                    <v:SettingRow Title="Port">
                      <TextBox x:Name="remotePortBox" Width="110" Text="5555" LostFocus="RemoteSettings_LostFocus" />
                    </v:SettingRow>
                    <v:SettingRow Title="Token" Description="The token shown on the other PC's Network page.">
                      <TextBox x:Name="remoteTokenBox" Width="170" PasswordChar="●" LostFocus="RemoteSettings_LostFocus" />
                    </v:SettingRow>
                    <v:StatusBadge x:Name="remoteStatusBadge" Margin="0,10,0,0" />
                  </StackPanel>
                </v:Section>

                <v:Section x:Name="netInputSection" IsVisible="False" Title="Input · capture and blocking" Description="While a listed program is focused and the virtual controller is connected, the keys and mouse buttons you mapped to pad actions (and mouse movement, if mouse look is on) are swallowed so only the controller reaches the game. Unmapped input and the toggle hotkey are never blocked.">
                  <StackPanel>
                    <v:SettingRow Title="Capture method" Description="Low-Level Hooks can block mapped input; Raw Input cannot.">
                      <ComboBox x:Name="inputMethodBox" MinWidth="150" SelectionChanged="InputMethodBox_SelectionChanged" />
                    </v:SettingRow>
                    <v:SettingRow Title="Block mapped input" Description="While a listed program is focused.">
                      <ToggleSwitch x:Name="blockEnabledBox" OnContent="" OffContent="" IsCheckedChanged="BlockSettings_Changed" />
                    </v:SettingRow>
                    <v:SettingRow Title="Block keyboard">
                      <ToggleSwitch x:Name="blockKeyboardBox" IsChecked="True" OnContent="" OffContent="" IsCheckedChanged="BlockSettings_Changed" />
                    </v:SettingRow>
                    <v:SettingRow Title="Block mouse" Description="Buttons, wheel and mouse look.">
                      <ToggleSwitch x:Name="blockMouseBox" IsChecked="True" OnContent="" OffContent="" IsCheckedChanged="BlockSettings_Changed" />
                    </v:SettingRow>
                    <v:SettingRow Title="Toggle / panic hotkey" Description="Turns blocking on or off; never blocked itself.">
                      <ComboBox x:Name="blockHotkeyBox" MinWidth="110" SelectionChanged="BlockHotkeyBox_SelectionChanged" />
                    </v:SettingRow>
                    <StackPanel Spacing="6" Margin="0,12,0,0">
                      <TextBlock Classes="label" Text="Game programs (process names, separated by commas)" TextWrapping="Wrap" />
                      <TextBox x:Name="blockProcessesBox" Watermark="game.exe, other.exe" LostFocus="BlockSettings_LostFocus" />
                      <ComboBox x:Name="blockRunningBox" HorizontalAlignment="Stretch" PlaceholderText="Running programs" />
                      <WrapPanel>
                        <Button x:Name="blockRefreshButton" Content="Refresh" Margin="0,0,8,6" Click="BlockRefresh_Click" />
                        <Button x:Name="blockAddButton" Content="Add selected" Margin="0,0,8,6" Click="BlockAdd_Click" />
                        <Button x:Name="blockRestoreButton" Content="Restore input now" Margin="0,0,0,6" Click="BlockRestore_Click" ToolTip.Tip="Releases blocking immediately" />
                      </WrapPanel>
                      <v:StatusBadge x:Name="blockStatusBadge" />
                      <TextBlock x:Name="blockStatusLabel" Classes="caption" Text="Input blocking is off" />
                    </StackPanel>
                  </StackPanel>
                </v:Section>
              </StackPanel>

              <v:Section x:Name="appearanceSection" Title="Appearance and files" IsVisible="False" MaxWidth="820" HorizontalAlignment="Left">
                <StackPanel>
                  <v:SettingRow Title="Dark mode">
                    <ToggleSwitch x:Name="darkModeToggle" IsChecked="True" OnContent="" OffContent="" Click="DarkModeToggle_Click" />
                  </v:SettingRow>
                  <v:SettingRow Title="Profiles folder" Description="Settings and profiles are plain JSON files next to the app. Older files keep loading.">
                    <Button Click="OpenProfilesFolderButton_Click"><StackPanel Orientation="Horizontal" Spacing="8"><v:Icon Kind="folder" /><TextBlock Text="Open" /></StackPanel></Button>
                  </v:SettingRow>
                  <TextBlock x:Name="dataPathLabel" Classes="caption mono" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
              </v:Section>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>
    </Grid>

    <!-- ═══════════════ Message line ═══════════════ -->
    <Border Grid.Row="1" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrushSubtle}" BorderThickness="0,1,0,0" Padding="16,4">
      <TextBlock x:Name="statusLabel" Classes="caption" Text="Status: Not connected" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
    </Border>
  </Grid>
</Window>
