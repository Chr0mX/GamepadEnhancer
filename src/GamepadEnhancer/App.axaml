<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GamepadEnhancer.App"
             RequestedThemeVariant="Dark">

  <!--
    Design tokens. Dark is the primary theme; Light mirrors it. Everything in the UI reads these keys (never a literal colour),
    so a colour is changed in exactly one place. Text/background pairs keep at least 4.5:1 contrast (muted text on surface is ~6:1).
  -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <!-- surfaces -->
          <SolidColorBrush x:Key="CanvasBrush" Color="#0F1115" />
          <SolidColorBrush x:Key="SidebarBrush" Color="#12151A" />
          <SolidColorBrush x:Key="SurfaceBrush" Color="#161920" />
          <SolidColorBrush x:Key="RaisedBrush" Color="#1D212B" />
          <SolidColorBrush x:Key="HoverBrush" Color="#242936" />
          <SolidColorBrush x:Key="PressedBrush" Color="#2B3140" />
          <!-- borders -->
          <SolidColorBrush x:Key="BorderBrushSubtle" Color="#242934" />
          <SolidColorBrush x:Key="BorderBrushDefault" Color="#2F3542" />
          <SolidColorBrush x:Key="BorderBrushStrong" Color="#434B5C" />
          <!-- text -->
          <SolidColorBrush x:Key="TextBrush" Color="#E6E8EC" />
          <SolidColorBrush x:Key="MutedTextBrush" Color="#A0A8B8" />
          <SolidColorBrush x:Key="FaintTextBrush" Color="#757D8E" />
          <!-- the single accent, plus its tint for selected/active backgrounds -->
          <SolidColorBrush x:Key="AccentBrush" Color="#4C8DFF" />
          <SolidColorBrush x:Key="AccentHoverBrush" Color="#6AA0FF" />
          <SolidColorBrush x:Key="AccentTintBrush" Color="#1A2A47" />
          <SolidColorBrush x:Key="AccentTextBrush" Color="#7DAAFF" />
          <SolidColorBrush x:Key="OnAccentBrush" Color="#0B1020" />
          <!-- status -->
          <SolidColorBrush x:Key="SuccessBrush" Color="#3FB68B" />
          <SolidColorBrush x:Key="WarningBrush" Color="#E5A23C" />
          <SolidColorBrush x:Key="DangerBrush" Color="#E5484D" />
          <SolidColorBrush x:Key="DangerTintBrush" Color="#3A1D20" />
          <Color x:Key="SystemAccentColor">#4C8DFF</Color>
          <Color x:Key="SystemAccentColorLight1">#6AA0FF</Color>
          <Color x:Key="SystemAccentColorLight2">#8DB7FF</Color>
          <Color x:Key="SystemAccentColorDark1">#3A78E6</Color>
          <Color x:Key="SystemAccentColorDark2">#2C63C9</Color>

          <!-- Fluent control resources, pointed at the tokens above so hover/pressed/focus/disabled come from them -->
          <StaticResource x:Key="ButtonBackground" ResourceKey="RaisedBrush" />
          <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="HoverBrush" />
          <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="PressedBrush" />
          <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="SurfaceBrush" />
          <StaticResource x:Key="ButtonForeground" ResourceKey="TextBrush" />
          <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="TextBrush" />
          <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="TextBrush" />
          <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="FaintTextBrush" />
          <StaticResource x:Key="ButtonBorderBrush" ResourceKey="BorderBrushDefault" />
          <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="BorderBrushStrong" />
          <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="BorderBrushStrong" />
          <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="BorderBrushSubtle" />
          <StaticResource x:Key="TextControlBackground" ResourceKey="SurfaceBrush" />
          <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="SurfaceBrush" />
          <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="SurfaceBrush" />
          <StaticResource x:Key="TextControlBackgroundDisabled" ResourceKey="SidebarBrush" />
          <StaticResource x:Key="TextControlBorderBrush" ResourceKey="BorderBrushDefault" />
          <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="BorderBrushStrong" />
          <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="AccentBrush" />
          <StaticResource x:Key="TextControlBorderBrushDisabled" ResourceKey="BorderBrushSubtle" />
          <StaticResource x:Key="TextControlForeground" ResourceKey="TextBrush" />
          <StaticResource x:Key="TextControlForegroundPointerOver" ResourceKey="TextBrush" />
          <StaticResource x:Key="TextControlForegroundFocused" ResourceKey="TextBrush" />
          <StaticResource x:Key="TextControlForegroundDisabled" ResourceKey="FaintTextBrush" />
          <StaticResource x:Key="TextControlPlaceholderForeground" ResourceKey="FaintTextBrush" />
          <StaticResource x:Key="ComboBoxBackground" ResourceKey="SurfaceBrush" />
          <StaticResource x:Key="ComboBoxBackgroundPointerOver" ResourceKey="SurfaceBrush" />
          <StaticResource x:Key="ComboBoxBackgroundPressed" ResourceKey="SurfaceBrush" />
          <StaticResource x:Key="ComboBoxBackgroundDisabled" ResourceKey="SidebarBrush" />
          <StaticResource x:Key="ComboBoxBorderBrush" ResourceKey="BorderBrushDefault" />
          <StaticResource x:Key="ComboBoxBorderBrushPointerOver" ResourceKey="BorderBrushStrong" />
          <StaticResource x:Key="ComboBoxBorderBrushPressed" ResourceKey="AccentBrush" />
          <StaticResource x:Key="ComboBoxBorderBrushDisabled" ResourceKey="BorderBrushSubtle" />
          <StaticResource x:Key="ComboBoxDropDownBackground" ResourceKey="RaisedBrush" />
          <StaticResource x:Key="ComboBoxDropDownBorderBrush" ResourceKey="BorderBrushDefault" />
          <StaticResource x:Key="ListBoxItemBackgroundPointerOver" ResourceKey="HoverBrush" />
          <StaticResource x:Key="ListBoxItemBackgroundSelected" ResourceKey="AccentTintBrush" />
          <StaticResource x:Key="ListBoxItemBackgroundSelectedPointerOver" ResourceKey="AccentTintBrush" />
          <StaticResource x:Key="ListBoxItemBackgroundSelectedPressed" ResourceKey="AccentTintBrush" />
          <StaticResource x:Key="ToolTipBackground" ResourceKey="RaisedBrush" />
          <StaticResource x:Key="ToolTipForeground" ResourceKey="TextBrush" />
          <StaticResource x:Key="ToolTipBorderBrush" ResourceKey="BorderBrushStrong" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="CanvasBrush" Color="#F3F4F7" />
          <SolidColorBrush x:Key="SidebarBrush" Color="#EAECF1" />
          <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="RaisedBrush" Color="#F6F7F9" />
          <SolidColorBrush x:Key="HoverBrush" Color="#E9EBF0" />
          <SolidColorBrush x:Key="PressedBrush" Color="#DDE0E7" />
          <SolidColorBrush x:Key="BorderBrushSubtle" Color="#E3E6EC" />
          <SolidColorBrush x:Key="BorderBrushDefault" Color="#D3D7E0" />
          <SolidColorBrush x:Key="BorderBrushStrong" Color="#B3B9C6" />
          <SolidColorBrush x:Key="TextBrush" Color="#161A22" />
          <SolidColorBrush x:Key="MutedTextBrush" Color="#505869" />
          <SolidColorBrush x:Key="FaintTextBrush" Color="#6F7787" />
          <SolidColorBrush x:Key="AccentBrush" Color="#2F6FEB" />
          <SolidColorBrush x:Key="AccentHoverBrush" Color="#4A82F0" />
          <SolidColorBrush x:Key="AccentTintBrush" Color="#DCE7FD" />
          <SolidColorBrush x:Key="AccentTextBrush" Color="#2257C4" />
          <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="SuccessBrush" Color="#1E8F69" />
          <SolidColorBrush x:Key="WarningBrush" Color="#B97A12" />
          <SolidColorBrush x:Key="DangerBrush" Color="#CC2F35" />
          <SolidColorBrush x:Key="DangerTintBrush" Color="#FBE3E4" />
          <Color x:Key="SystemAccentColor">#2F6FEB</Color>
          <Color x:Key="SystemAccentColorLight1">#4A82F0</Color>
          <Color x:Key="SystemAccentColorLight2">#6B9BF3</Color>
          <Color x:Key="SystemAccentColorDark1">#2559C4</Color>
          <Color x:Key="SystemAccentColorDark2">#1C47A0</Color>

          <!-- Fluent control resources, pointed at the tokens above so hover/pressed/focus/disabled come from them -->
          <StaticResource x:Key="ButtonBackground" ResourceKey="RaisedBrush" />
          <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="HoverBrush" />
          <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="PressedBrush" />
          <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="SurfaceBrush" />
          <StaticResource x:Key="ButtonForeground" ResourceKey="TextBrush" />
          <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="TextBrush" />
          <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="TextBrush" />
          <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="FaintTextBrush" />
          <StaticResource x:Key="ButtonBorderBrush" ResourceKey="BorderBrushDefault" />
          <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="BorderBrushStrong" />
          <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="BorderBrushStrong" />
          <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="BorderBrushSubtle" />
          <StaticResource x:Key="TextControlBackground" ResourceKey="SurfaceBrush" />
          <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="SurfaceBrush" />
          <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="SurfaceBrush" />
          <StaticResource x:Key="TextControlBackgroundDisabled" ResourceKey="SidebarBrush" />
          <StaticResource x:Key="TextControlBorderBrush" ResourceKey="BorderBrushDefault" />
          <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="BorderBrushStrong" />
          <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="AccentBrush" />
          <StaticResource x:Key="TextControlBorderBrushDisabled" ResourceKey="BorderBrushSubtle" />
          <StaticResource x:Key="TextControlForeground" ResourceKey="TextBrush" />
          <StaticResource x:Key="TextControlForegroundPointerOver" ResourceKey="TextBrush" />
          <StaticResource x:Key="TextControlForegroundFocused" ResourceKey="TextBrush" />
          <StaticResource x:Key="TextControlForegroundDisabled" ResourceKey="FaintTextBrush" />
          <StaticResource x:Key="TextControlPlaceholderForeground" ResourceKey="FaintTextBrush" />
          <StaticResource x:Key="ComboBoxBackground" ResourceKey="SurfaceBrush" />
          <StaticResource x:Key="ComboBoxBackgroundPointerOver" ResourceKey="SurfaceBrush" />
          <StaticResource x:Key="ComboBoxBackgroundPressed" ResourceKey="SurfaceBrush" />
          <StaticResource x:Key="ComboBoxBackgroundDisabled" ResourceKey="SidebarBrush" />
          <StaticResource x:Key="ComboBoxBorderBrush" ResourceKey="BorderBrushDefault" />
          <StaticResource x:Key="ComboBoxBorderBrushPointerOver" ResourceKey="BorderBrushStrong" />
          <StaticResource x:Key="ComboBoxBorderBrushPressed" ResourceKey="AccentBrush" />
          <StaticResource x:Key="ComboBoxBorderBrushDisabled" ResourceKey="BorderBrushSubtle" />
          <StaticResource x:Key="ComboBoxDropDownBackground" ResourceKey="RaisedBrush" />
          <StaticResource x:Key="ComboBoxDropDownBorderBrush" ResourceKey="BorderBrushDefault" />
          <StaticResource x:Key="ListBoxItemBackgroundPointerOver" ResourceKey="HoverBrush" />
          <StaticResource x:Key="ListBoxItemBackgroundSelected" ResourceKey="AccentTintBrush" />
          <StaticResource x:Key="ListBoxItemBackgroundSelectedPointerOver" ResourceKey="AccentTintBrush" />
          <StaticResource x:Key="ListBoxItemBackgroundSelectedPressed" ResourceKey="AccentTintBrush" />
          <StaticResource x:Key="ToolTipBackground" ResourceKey="RaisedBrush" />
          <StaticResource x:Key="ToolTipForeground" ResourceKey="TextBrush" />
          <StaticResource x:Key="ToolTipBorderBrush" ResourceKey="BorderBrushStrong" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <!-- Legacy keys some code-built controls still read. -->
      <x:Double x:Key="ControlHeight">32</x:Double>
      <x:Double x:Key="NavItemHeight">36</x:Double>
      <CornerRadius x:Key="RadiusControl">6</CornerRadius>
      <CornerRadius x:Key="RadiusPanel">8</CornerRadius>
      <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI, Inter, sans-serif</FontFamily>
      <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Menlo, monospace</FontFamily>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <StyleInclude Source="/Styles/Theme.axaml" />
    <StyleInclude Source="/Styles/Components.axaml" />
  </Application.Styles>
</Application>
